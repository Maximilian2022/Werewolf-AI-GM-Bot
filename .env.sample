# ==========================================
# Discord Bot 設定
# ==========================================
# メイン進行用（GM）BotのトークンとクライアントID
GM_BOT_TOKEN="your_discord_bot_token_here"
GM_CLIENT_ID="your_discord_client_id_here"

# 霊界・内通監視用（アシスタント）Botのトークン
ASSISTANT_BOT_TOKEN="your_assistant_bot_token_here"

# 【デバッグ用】人数合わせ用のバイト（Worker）Botトークン
# カンマ区切りで複数指定可能（例: token1,token2,token3）
WORKER_TOKENS=""

# ==========================================
# API 認証設定
# ==========================================
# Google Gemini API キー (MVP解析用)
GEMINI_API_KEY="your_gemini_api_key_here"

# Google Cloud Project ID (TTS用)
GOOGLE_CLOUD_PROJECT="your_gcp_project_id_here"

# コンテナ内でのGCPサービスアカウントキーのパス
# ※通常はこのまま（docker-compose.ymlのマウント先）でOK
GOOGLE_APPLICATION_CREDENTIALS="/app/gcp-key.json"

# ==========================================
# サーバー・デプロイ設定
# ==========================================
# スラッシュコマンドを登録するメインサーバーのID
TEST_GUILD_ID="your_discord_server_id_here"