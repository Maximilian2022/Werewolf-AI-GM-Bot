# ==========================================
# 人狼 AI GM Bot 環境変数設定サンプル (.env.example)
# ==========================================
# 本ファイルをコピーして `.env` を作成し、各項目に適切な値を設定してください。
# cp .env.example .env

# ------------------------------------------
# 1. Discord Bot トークン・ID設定 (必須)
# ------------------------------------------
# メインGM Bot の Bot Token (Discord Developer Portal から取得)
GM_BOT_TOKEN=your_main_gm_bot_token_here

# メインGM Bot の Application (Client) ID
GM_CLIENT_ID=your_gm_client_id_here

# アシスタント Bot の Bot Token (進行案内・アナウンス補助)
ASSISTANT_BOT_TOKEN=your_assistant_bot_token_here

# バイトBot (Worker Bot) のトークン一覧 (カンマ区切り)
# 各プレイヤーの個別待機VCへの音声再生・相槌用。4〜16体程度を推奨
WORKER_TOKENS=worker_token_1,worker_token_2,worker_token_3,worker_token_4

# コマンド登録および権限検証対象の Discord サーバー (Guild) ID
TEST_GUILD_ID=your_discord_guild_id_here

# ------------------------------------------
# 2. Google AI / Cloud 連携設定 (音声合成・AI総評)
# ------------------------------------------
# Google Gemini API キー (ゲーム終了後のAI自動総評・MVP選出に使用)
# Google AI Studio (https://aistudio.google.com/) から発行
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Text-to-Speech (TTS) 認証情報
# サービスアカウントキー (JSON) のコンテナ内絶対パス、またはプロジェクトルートからの相対パス
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-tts.json

# Google Cloud プロジェクト ID
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id

# ------------------------------------------
# 3. Web管理ダッシュボード & OAuth2 設定
# ------------------------------------------
# Express セッション暗号化シークレット (ランダムな文字列を設定)
SESSION_SECRET=replace_with_a_secure_random_string_here

# ダッシュボード上で管理者機能（設定変更・Tunnel制御）を許可する Discord ユーザーID (カンマ区切り)
# サーバーオーナーまたは特定の管理者の Discord ユーザーID
ADMIN_USER_IDS=123456789012345678,234567890123456789

# WebUI Discord OAuth2 ログイン連携 (Developer Portal の OAuth2 ページで設定)
# 設定しない場合、ダッシュボードの「設定」タブから動的に設定・保存することも可能です
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ------------------------------------------
# 4. システム共通設定
# ------------------------------------------
# 実行環境 ('production' または 'development')
NODE_ENV=production

# タイムゾーン (日本標準時: Asia/Tokyo)
TZ=Asia/Tokyo
